# AirPower Decision-Support Platform Environment Configuration
# All configurations are optional; by default, the system runs with deterministic
# in-memory algorithms and mock data with zero external credentials required.

# -------------------------------------------------------------
# AI Operations Assistant LLM Provider Configuration
# -------------------------------------------------------------
# If LLM_API_KEY is not set or empty, the assistant uses the built-in
# DeterministicRuleProvider (fast, zero external calls, 100% adherence to allowlist).
#
# Supported providers: OpenAI, Google Gemini (via OpenAI-compatible endpoint), Anthropic, local vLLM/Ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Alternative dedicated environment variable names (also detected automatically):
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

# -------------------------------------------------------------
# Open-Meteo Weather API
# -------------------------------------------------------------
# Open-Meteo operates without an API key for non-commercial open data usage.
# If using a commercial Open-Meteo enterprise key, set it below:
# OPEN_METEO_API_KEY=
